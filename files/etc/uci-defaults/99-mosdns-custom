#!/bin/sh

# 使用自定义配置
uci -q set mosdns.config.configfile='/etc/mosdns/config_custom.yaml'
uci -q set mosdns.config.enabled='1'
uci commit mosdns

# 给脚本加执行权限
chmod +x /etc/mosdns/update_ads.sh 2>/dev/null
chmod +x /etc/mosdns/update_geo.sh 2>/dev/null

# 每天凌晨 3:20 更新 Geo，3:30 更新广告
grep -q "update_geo.sh" /etc/crontabs/root 2>/dev/null || \
  echo "20 3 * * * /etc/mosdns/update_geo.sh >/dev/null 2>&1" >> /etc/crontabs/root

grep -q "update_ads.sh" /etc/crontabs/root 2>/dev/null || \
  echo "30 3 * * * /etc/mosdns/update_ads.sh >/dev/null 2>&1" >> /etc/crontabs/root

exit 0
