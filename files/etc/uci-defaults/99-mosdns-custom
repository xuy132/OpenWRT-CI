#!/bin/sh

# 启用自定义配置
uci set mosdns.config.configfile='/etc/mosdns/config_custom.yaml'
uci set mosdns.config.enabled='1'
uci set mosdns.config.listen_port='5335'   # 根据需要
uci commit mosdns

# 添加广告自动更新定时任务
echo "30 3 * * * /etc/mosdns/update_ads.sh >/dev/null 2>&1" >> /etc/crontabs/root

# 可选：首次启动后自动跑一次广告更新
# /etc/mosdns/update_ads.sh &

exit 0
