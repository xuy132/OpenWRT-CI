#!/bin/sh

# 启用 MosDNS 自定义配置
uci set mosdns.config.enabled='1'
uci set mosdns.config.configfile='custom'
uci commit mosdns

# 创建广告规则目录
mkdir -p /tmp/mosdns_ads
mkdir -p /etc/mosdns

# 写入自动更新脚本
cat > /etc/mosdns/update_ads.sh << 'EOF'
#!/bin/sh
mkdir -p /tmp/mosdns_ads
curl -sL --connect-timeout 10 --max-time 30 -o /tmp/mosdns_ads/anti-ad.txt https://anti-ad.net/domains.txt
curl -sL --connect-timeout 10 --max-time 30 -o /tmp/mosdns_ads/adguard.txt https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt
/etc/init.d/mosdns restart >/dev/null 2>&1
EOF
chmod +x /etc/mosdns/update_ads.sh

# 添加每周六凌晨更新的定时任务
grep -q "update_ads.sh" /etc/crontabs/root || echo "30 5 * * 6 /etc/mosdns/update_ads.sh" >> /etc/crontabs/root
/etc/init.d/cron enable
/etc/init.d/cron restart

# 首次立即更新一次广告规则
/etc/mosdns/update_ads.sh &

exit 0